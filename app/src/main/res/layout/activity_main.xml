<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 播放区：默认铺满全屏，两栏列表浮在左侧；不可聚焦，避免抢走列表焦点 -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <LinearLayout
        android:id="@+id/infoBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC000000"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/infoChannelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="CCTV-1" />

        <TextView
            android:id="@+id/infoMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="央视 · 线路 1/5" />

        <TextView
            android:id="@+id/infoProgram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="正在播：新闻联播　接下来：焦点访谈"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/errorHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC000000"
        android:padding="16dp"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:visibility="gone"
        tools:text="正在播放…" />

    <!-- 两栏列表面板：左＝分组，右＝该分组的频道（全屏最大化时整体隐藏） -->
    <LinearLayout
        android:id="@+id/listPanel"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@color/bg_list"
        android:elevation="4dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- ============ 左栏：分组 ============ -->
            <LinearLayout
                android:layout_width="@dimen/group_lane_width"
                android:layout_height="match_parent"
                android:background="@color/bg_list_header"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:text="@string/channel_list_title"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/groupList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="12dp"
                    tools:listitem="@layout/item_group_lane" />
            </LinearLayout>

            <!-- ============ 右栏：当前分组的频道 ============ -->
            <LinearLayout
                android:layout_width="@dimen/channel_lane_width"
                android:layout_height="match_parent"
                android:background="@color/bg_list"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/laneTitle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:text="央视 · 22 个频道" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/channelList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingHorizontal="6dp"
                        android:paddingBottom="16dp"
                        tools:listitem="@layout/item_channel" />

                    <ProgressBar
                        android:id="@+id/loadingBar"
                        style="?android:attr/progressBarStyle"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/laneHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_list_header"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="OK / → 展开分组　← / 返回 收起　长按 OK 收藏"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
