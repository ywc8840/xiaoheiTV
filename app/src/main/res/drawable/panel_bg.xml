<?xml version="1.0" encoding="utf-8"?>
<!--
  浮层面板：完全不透明（这台电视没有实时模糊，半透明会把画面细节透成噪点），
  靠极淡的上下渐变做出体积感，再配一圈 12% 白发的发丝边。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#FF111113"
        android:startColor="#FF1B1B1E"
        android:type="linear" />
    <corners android:radius="@dimen/panel_radius" />
    <stroke
        android:width="1dp"
        android:color="@color/hairline" />
</shape>
