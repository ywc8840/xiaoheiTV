<?xml version="1.0" encoding="utf-8"?>
<!--
  频道卡片：
    焦点     → 白 14% 底 + 1.5dp 白描边（配合 1.02 的轻微放大，焦点会"抬"起来）
    正在播放 → 白 6% 底，非常安静，只为了让正在播的台在列表里有存在感
    其余     → 透明
  刻意不用蓝色实底：台标多是透明 PNG，蓝底会让暖色台标发脏。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/focus_fill" />
            <corners android:radius="15dp" />
            <stroke
                android:width="2dp"
                android:color="@color/focus_stroke" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/playing_fill" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</selector>
